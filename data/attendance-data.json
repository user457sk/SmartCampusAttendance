const state = {
  students: [],
  records: [],
  selectedDate: getTodayDate(),
  selectedTime: '09:00',
  activeRole: 'teacher',
};

const refs = {
  calendarTitle: document.getElementById('calendarTitle'),
  calendarGrid: document.getElementById('calendarGrid'),
  selectedDate: document.getElementById('selectedDate'),
  selectedTime: document.getElementById('selectedTime'),
  subjectFilter: document.getElementById('subjectFilter'),
  studentTableBody: document.getElementById('studentTableBody'),
  attendanceForm: document.getElementById('attendanceForm'),
  studentForm: document.getElementById('studentForm'),
  recordsList: document.getElementById('recordsList'),
  summaryStats: document.getElementById('summaryStats'),
  selectedContext: document.getElementById('selectedContext'),
  attendanceDate: document.getElementById('attendanceDate'),
  attendanceTime: document.getElementById('attendanceTime'),
  subjectName: document.getElementById('subjectName'),
  teacherName: document.getElementById('teacherName'),
  markAllPresent: document.getElementById('markAllPresent'),
  markAllAbsent: document.getElementById('markAllAbsent'),
  exportCsv: document.getElementById('exportCsv'),
  printPdf: document.getElementById('printPdf'),
  roleButtons: [...document.querySelectorAll('.role-btn')],
};

let currentMonth = new Date().getMonth();
let currentYear = new Date().getFullYear();
let draftEntries = [];

initialize();

async function initialize() {
  await loadInitialData();

  refs.selectedDate.value = state.selectedDate;
  refs.attendanceDate.value = state.selectedDate;
  refs.attendanceTime.value = state.selectedTime;
  refs.selectedTime.value = state.selectedTime;

  refs.selectedDate.addEventListener('input', () => {
    state.selectedDate = refs.selectedDate.value || getTodayDate();
    refs.attendanceDate.value = state.selectedDate;
    refreshDraftFromCurrentSession();
    renderCalendar();
    renderRecords();
  });

  refs.attendanceDate.addEventListener('input', () => {
    state.selectedDate = refs.attendanceDate.value || getTodayDate();
    refs.selectedDate.value = state.selectedDate;
    refreshDraftFromCurrentSession();
    renderCalendar();
    renderRecords();
  });

  refs.selectedTime.addEventListener('input', () => {
    state.selectedTime = refs.selectedTime.value || '09:00';
    refs.attendanceTime.value = state.selectedTime;
    refreshDraftFromCurrentSession();
    renderRecords();
  });

  refs.attendanceTime.addEventListener('input', () => {
    state.selectedTime = refs.attendanceTime.value || '09:00';
    refs.selectedTime.value = state.selectedTime;
    refreshDraftFromCurrentSession();
    renderRecords();
  });

  refs.subjectFilter.addEventListener('input', renderRecords);

  refs.studentForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const name = document.getElementById('studentNameInput').value.trim();
    const rollNo = document.getElementById('studentRollInput').value.trim();
    const className = document.getElementById('studentClassInput').value.trim();

    if (!name || !rollNo || !className) {
      alert('Please fill out all student details.');
      return;
    }

    try {
      const response = await fetch('/api/students', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, rollNo, className }),
      });

      if (!response.ok) {
        throw new Error('Failed to add student.');
      }

      refs.studentForm.reset();
      await loadInitialData();
      refreshDraftFromCurrentSession();
      renderStudentTable();
      renderSummary();
    } catch (error) {
      alert(error.message || 'Unable to add student.');
    }
  });

  refs.attendanceForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const date = refs.attendanceDate.value;
    const time = refs.attendanceTime.value;
    const subject = refs.subjectName.value.trim();
    const teacher = refs.teacherName.value.trim();

    if (!date || !time || !subject || !teacher) {
      alert('Please fill all attendance fields before saving.');
      return;
    }

    try {
      const response = await fetch('/api/records', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          date,
          time,
          subject,
          teacher,
          entries: draftEntries,
        }),
      });

      if (!response.ok) {
        throw new Error('Unable to save attendance.');
      }

      await loadInitialData();
      refreshDraftFromCurrentSession();
      renderStudentTable();
      renderRecords();
      renderSummary();
      alert('Attendance saved successfully.');
    } catch (error) {
      alert(error.message || 'Unable to save attendance.');
    }
  });

  refs.markAllPresent.addEventListener('click', () => applyStatusToAll('present'));
  refs.markAllAbsent.addEventListener('click', () => applyStatusToAll('absent'));
  refs.exportCsv.addEventListener('click', () => window.open('/api/export/csv', '_blank'));
  refs.printPdf.addEventListener('click', () => window.print());

  refs.roleButtons.forEach((button) => {
    button.addEventListener('click', () => {
      state.activeRole = button.dataset.role;
      refs.roleButtons.forEach((btn) => btn.classList.toggle('active', btn === button));
      renderSummary();
    });
  });

  document.getElementById('prevMonth').addEventListener('click', () => changeMonth(-1));
  document.getElementById('nextMonth').addEventListener('click', () => changeMonth(1));

  refreshDraftFromCurrentSession();
  renderCalendar();
  renderStudentTable();
  renderRecords();
  renderSummary();
}

async function loadInitialData() {
  const [studentsResponse, recordsResponse, summaryResponse] = await Promise.all([
    fetch('/api/students'),
    fetch('/api/records'),
    fetch('/api/summary'),
  ]);

  state.students = await studentsResponse.json();
  state.records = await recordsResponse.json();
  state.summary = await summaryResponse.json();
}

function refreshDraftFromCurrentSession() {
  const date = refs.attendanceDate.value || state.selectedDate;
  const time = refs.attendanceTime.value || state.selectedTime;
  const subject = refs.subjectName.value.trim() || 'Mathematics';
  const teacher = refs.teacherName.value.trim() || 'Teacher';

  refs.selectedContext.textContent = `${date} • ${time}`;

  const matchingRecord = state.records.find(
    (record) =>
      record.date === date && record.time === time && record.subject === subject && record.teacher === teacher,
  );

  const map = new Map((matchingRecord?.entries || []).map((entry) => [entry.studentId, entry.status]));
  draftEntries = state.students.map((student) => ({
    studentId: student.id,
    status: map.get(student.id) || 'absent',
  }));
}

function renderCalendar() {
  const monthStart = new Date(currentYear, currentMonth, 1);
  const weekdayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  refs.calendarTitle.textContent = monthStart.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  refs.calendarGrid.innerHTML = '';

  weekdayNames.forEach((day) => {
    const cell = document.createElement('div');
    cell.className = 'calendar-weekday';
    cell.textContent = day;
    refs.calendarGrid.appendChild(cell);
  });

  const startDay = new Date(currentYear, currentMonth, 1).getDay();
  const firstCalendarDay = new Date(currentYear, currentMonth, 1 - startDay);

  for (let i = 0; i < 42; i += 1) {
    const date = new Date(firstCalendarDay);
    date.setDate(firstCalendarDay.getDate() + i);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'day';
    button.textContent = date.getDate();

    const dateKey = formatIsoDate(date);
    if (date.getMonth() !== currentMonth) button.classList.add('outside');
    if (dateKey === getTodayDate()) button.classList.add('today');
    if (dateKey === state.selectedDate) button.classList.add('selected');

    button.addEventListener('click', () => {
      state.selectedDate = dateKey;
      refs.selectedDate.value = state.selectedDate;
      refs.attendanceDate.value = state.selectedDate;
      refreshDraftFromCurrentSession();
      renderCalendar();
      renderRecords();
    });

    refs.calendarGrid.appendChild(button);
  }
}

function renderStudentTable() {
  const rows = state.students.map((student) => {
    const entry = draftEntries.find((item) => item.studentId === student.id) || { status: 'absent' };
    const status = entry.status;

    return `
      <tr>
        <td>${student.rollNo}</td>
        <td>${student.name}</td>
        <td>${student.className}</td>
        <td>
          <div class="status-group">
            <button type="button" class="status-btn present ${status === 'present' ? 'active' : ''}" data-student-id="${student.id}" data-status="present">Present</button>
            <button type="button" class="status-btn late ${status === 'late' ? 'active' : ''}" data-student-id="${student.id}" data-status="late">Late</button>
            <button type="button" class="status-btn absent ${status === 'absent' ? 'active' : ''}" data-student-id="${student.id}" data-status="absent">Absent</button>
          </div>
        </td>
      </tr>
    `;
  }).join('');

  refs.studentTableBody.innerHTML = rows || '<tr><td colspan="4">No students added yet.</td></tr>';

  refs.studentTableBody.querySelectorAll('.status-btn').forEach((button) => {
    button.addEventListener('click', () => updateDraftStatus(button.dataset.studentId, button.dataset.status));
  });
}

function updateDraftStatus(studentId, status) {
  const entry = draftEntries.find((item) => item.studentId === studentId);
  if (entry) {
    entry.status = status;
  } else {
    draftEntries.push({ studentId, status });
  }
  renderStudentTable();
}

function applyStatusToAll(status) {
  draftEntries = state.students.map((student) => ({
    studentId: student.id,
    status,
  }));
  renderStudentTable();
}

function renderRecords() {
  const filterText = refs.subjectFilter.value.trim().toLowerCase();
  const selectedDate = refs.selectedDate.value || state.selectedDate;
  const selectedTime = refs.selectedTime.value || state.selectedTime;

  const filtered = state.records.filter((record) => {
    const matchesDate = record.date === selectedDate;
    const matchesTime = record.time === selectedTime;
    const matchesSubject = !filterText || record.subject.toLowerCase().includes(filterText);
    return matchesDate && matchesTime && matchesSubject;
  });

  if (!filtered.length) {
    refs.recordsList.innerHTML = '<div class="empty-state">No attendance record found for this date and time.</div>';
    return;
  }

  refs.recordsList.innerHTML = filtered.map((record) => {
    const counts = getCounts(record.entries);
    return `
      <div class="record-item">
        <div class="record-head">
          <div>
            <div class="record-title">${record.subject}</div>
            <div class="record-meta">${record.teacher} • ${record.date} • ${record.time}</div>
          </div>
          <div class="record-meta">P: ${counts.present} | A: ${counts.absent} | L: ${counts.late}</div>
        </div>
      </div>
    `;
  }).join('');
}

function renderSummary() {
  const summary = state.summary || {
    totalStudents: state.students.length,
    present: 0,
    absent: 0,
    late: 0,
  };

  refs.summaryStats.innerHTML = `
    <div class="stat-box">
      <div class="label">Total Students</div>
      <div class="value">${summary.totalStudents}</div>
    </div>
    <div class="stat-box">
      <div class="label">Present</div>
      <div class="value">${summary.present}</div>
    </div>
    <div class="stat-box">
      <div class="label">Absent</div>
      <div class="value">${summary.absent}</div>
    </div>
    <div class="stat-box">
      <div class="label">Late</div>
      <div class="value">${summary.late}</div>
    </div>
  `;
}

function changeMonth(delta) {
  const nextDate = new Date(currentYear, currentMonth + delta, 1);
  currentMonth = nextDate.getMonth();
  currentYear = nextDate.getFullYear();
  renderCalendar();
}

function getCounts(entries = []) {
  const summary = { present: 0, absent: 0, late: 0 };
  entries.forEach((entry) => {
    if (summary[entry.status] !== undefined) summary[entry.status] += 1;
  });
  return summary;
}

function formatIsoDate(date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

function getTodayDate() {
  return formatIsoDate(new Date());
}
