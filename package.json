const express = require('express');
const path = require('path');
const fs = require('fs');
const bcrypt = require('bcryptjs');
const session = require('express-session');
const Database = require('better-sqlite3');

const app = express();
const PORT = process.env.PORT || 3000;
const dataDir = path.join(__dirname, 'data');
const dbPath = path.join(dataDir, 'smartcampus.db');

fs.mkdirSync(dataDir, { recursive: true });
const db = new Database(dbPath);

db.exec(`
  CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    password_hash TEXT NOT NULL,
    role TEXT NOT NULL DEFAULT 'teacher',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  );

  CREATE TABLE IF NOT EXISTS students (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    roll_no TEXT NOT NULL,
    class_name TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  );

  CREATE TABLE IF NOT EXISTS attendance_records (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date TEXT NOT NULL,
    time TEXT NOT NULL,
    subject TEXT NOT NULL,
    teacher TEXT NOT NULL,
    created_by INTEGER,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(created_by) REFERENCES users(id)
  );

  CREATE TABLE IF NOT EXISTS attendance_entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    record_id INTEGER NOT NULL,
    student_id INTEGER NOT NULL,
    status TEXT NOT NULL,
    FOREIGN KEY(record_id) REFERENCES attendance_records(id),
    FOREIGN KEY(student_id) REFERENCES students(id)
  );
`);

const adminExists = db.prepare('SELECT COUNT(*) AS count FROM users WHERE role = ?').get('admin');
if (!adminExists.count) {
  const passwordHash = bcrypt.hashSync('admin123', 10);
  db.prepare(
    'INSERT INTO users (name, email, password_hash, role) VALUES (?, ?, ?, ?)' 
  ).run('System Admin', 'admin@smartcampus.com', passwordHash, 'admin');
}

app.use(express.json());
app.use(express.urlencoded({ extended: true }));
app.use(
  session({
    secret: 'smart-campus-session-secret',
    resave: false,
    saveUninitialized: false,
    cookie: { httpOnly: true, sameSite: 'lax', secure: false },
  })
);
app.use(express.static(path.join(__dirname, 'public')));

function requireAuth(req, res, next) {
  if (!req.session.userId) {
    return res.status(401).json({ message: 'Login required.' });
  }
  next();
}

function getUserById(id) {
  return db.prepare('SELECT id, name, email, role FROM users WHERE id = ?').get(id);
}

function getCounts(entries = []) {
  const summary = { present: 0, absent: 0, late: 0 };
  entries.forEach((entry) => {
    if (summary[entry.status] !== undefined) summary[entry.status] += 1;
  });
  return summary;
}

app.get('/api/auth/me', (req, res) => {
  if (!req.session.userId) {
    return res.status(401).json({ message: 'Not authenticated.' });
  }

  const user = getUserById(req.session.userId);
  res.json({ user });
});

app.post('/api/auth/signup', async (req, res) => {
  const { name, email, password, role } = req.body || {};

  if (!name || !email || !password) {
    return res.status(400).json({ message: 'Name, email and password are required.' });
  }

  const trimmedEmail = String(email).trim().toLowerCase();
  const trimmedName = String(name).trim();
  const safeRole = role === 'admin' ? 'admin' : 'teacher';

  const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(trimmedEmail);
  if (existing) {
    return res.status(409).json({ message: 'Email already in use.' });
  }

  const passwordHash = bcrypt.hashSync(String(password), 10);
  const result = db.prepare(
    'INSERT INTO users (name, email, password_hash, role) VALUES (?, ?, ?, ?)' 
  ).run(trimmedName, trimmedEmail, passwordHash, safeRole);

  req.session.userId = result.lastInsertRowid;
  const user = getUserById(req.session.userId);
  return res.status(201).json({ user });
});

app.post('/api/auth/login', (req, res) => {
  const { email, password } = req.body || {};

  if (!email || !password) {
    return res.status(400).json({ message: 'Email and password are required.' });
  }

  const user = db.prepare('SELECT * FROM users WHERE email = ?').get(String(email).trim().toLowerCase());
  if (!user) {
    return res.status(401).json({ message: 'Invalid email or password.' });
  }

  const passwordMatches = bcrypt.compareSync(String(password), user.password_hash);
  if (!passwordMatches) {
    return res.status(401).json({ message: 'Invalid email or password.' });
  }

  req.session.userId = user.id;
  return res.json({
    user: {
      id: user.id,
      name: user.name,
      email: user.email,
      role: user.role,
    },
  });
});

app.post('/api/auth/logout', (req, res) => {
  req.session.destroy(() => {
    res.json({ message: 'Logged out.' });
  });
});

app.get('/api/students', requireAuth, (req, res) => {
  const students = db.prepare('SELECT id, name, roll_no AS rollNo, class_name AS className FROM students ORDER BY name ASC').all();
  res.json(students);
});

app.post('/api/students', requireAuth, (req, res) => {
  const { name, rollNo, className } = req.body || {};

  if (!name || !rollNo || !className) {
    return res.status(400).json({ message: 'Name, roll number and class are required.' });
  }

  const result = db.prepare(
    'INSERT INTO students (name, roll_no, class_name) VALUES (?, ?, ?)' 
  ).run(String(name).trim(), String(rollNo).trim(), String(className).trim());

  const student = db.prepare(
    'SELECT id, name, roll_no AS rollNo, class_name AS className FROM students WHERE id = ?'
  ).get(result.lastInsertRowid);

  return res.status(201).json(student);
});

app.get('/api/records', requireAuth, (req, res) => {
  const { date, time, subject } = req.query;
  const rows = db.prepare(
    'SELECT id, date, time, subject, teacher FROM attendance_records ORDER BY date DESC, time DESC'
  ).all();

  const filtered = rows.filter((record) => {
    const matchesDate = !date || record.date === String(date);
    const matchesTime = !time || record.time === String(time);
    const matchesSubject = !subject || record.subject.toLowerCase().includes(String(subject).toLowerCase());
    return matchesDate && matchesTime && matchesSubject;
  });

  const records = filtered.map((record) => {
    const entries = db.prepare(
      'SELECT student_id AS studentId, status FROM attendance_entries WHERE record_id = ?'
    ).all(record.id);
    return { ...record, entries };
  });

  res.json(records);
});

app.post('/api/records', requireAuth, (req, res) => {
  const { date, time, subject, teacher, entries = [] } = req.body || {};

  if (!date || !time || !subject || !teacher) {
    return res.status(400).json({ message: 'Date, time, subject and teacher are required.' });
  }

  const existing = db.prepare(
    'SELECT id FROM attendance_records WHERE date = ? AND time = ? AND subject = ? AND teacher = ?'
  ).get(date, time, subject, teacher);

  if (existing) {
    db.prepare('DELETE FROM attendance_entries WHERE record_id = ?').run(existing.id);
    const insertEntry = db.prepare('INSERT INTO attendance_entries (record_id, student_id, status) VALUES (?, ?, ?)');
    const tx = db.transaction(() => {
      entries.forEach((entry) => {
        insertEntry.run(existing.id, entry.studentId, entry.status || 'absent');
      });
    });
    tx();
    return res.status(200).json({ message: 'Attendance updated successfully.' });
  }

  const result = db.prepare(
    'INSERT INTO attendance_records (date, time, subject, teacher, created_by) VALUES (?, ?, ?, ?, ?)' 
  ).run(date, time, subject, teacher, req.session.userId);

  const insertEntry = db.prepare('INSERT INTO attendance_entries (record_id, student_id, status) VALUES (?, ?, ?)');
  const tx = db.transaction(() => {
    entries.forEach((entry) => {
      insertEntry.run(result.lastInsertRowid, entry.studentId, entry.status || 'absent');
    });
  });

  tx();
  return res.status(201).json({ message: 'Attendance saved successfully.' });
});

app.get('/api/summary', requireAuth, (req, res) => {
  const students = db.prepare('SELECT id FROM students').all();
  const records = db.prepare('SELECT id FROM attendance_records').all();

  let present = 0;
  let absent = 0;
  let late = 0;

  records.forEach((record) => {
    const entries = db.prepare('SELECT status FROM attendance_entries WHERE record_id = ?').all(record.id);
    const counts = getCounts(entries);
    present += counts.present;
    absent += counts.absent;
    late += counts.late;
  });

  res.json({
    totalStudents: students.length,
    present,
    absent,
    late,
  });
});

app.get('/api/export/csv', requireAuth, (req, res) => {
  const students = db.prepare('SELECT id, name, roll_no AS rollNo, class_name AS className FROM students').all();
  const studentMap = new Map(students.map((s) => [s.id, s]));
  const records = db.prepare('SELECT id, date, time, subject, teacher FROM attendance_records ORDER BY date DESC, time DESC').all();

  const rows = [['Date', 'Time', 'Subject', 'Teacher', 'Student', 'Roll', 'Class', 'Status']];

  records.forEach((record) => {
    const entries = db.prepare('SELECT student_id AS studentId, status FROM attendance_entries WHERE record_id = ?').all(record.id);
    entries.forEach((entry) => {
      const student = studentMap.get(entry.studentId) || {};
      rows.push([
        record.date,
        record.time,
        record.subject,
        record.teacher,
        student.name || 'Unknown',
        student.rollNo || '',
        student.className || '',
        entry.status,
      ]);
    });
  });

  const csv = rows.map((row) => row.map((value) => `"${String(value).replace(/"/g, '""')}"`).join(',')).join('\n');
  res.setHeader('Content-Type', 'text/csv; charset=utf-8');
  res.setHeader('Content-Disposition', 'attachment; filename="attendance-records.csv"');
  res.send(csv);
});

app.get('*', (req, res) => {
  res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

app.listen(PORT, () => {
  console.log(`SmartCampusAttendance server running on http://localhost:${PORT}`);
});
